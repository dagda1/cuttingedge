{
  "name": "@cutting/react-hook-form-components",
  "version": "0.19.0",
  "description": "components for react-hook-form.",
  "keywords": [
    "focus",
    "hook",
    "hooks",
    "react",
    "react-hook-form",
    "reactjs",
    "reactnative"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dagda1/cuttingedge.git"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "module": "dist/esm/src.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/src.js"
    },
    "./styles.css": {
      "import": "./dist/esm/src.css"
    },
    "./package.json": {
      "import": "./package.json"
    }
  },
  "scripts": {
    "start": "pnpm vite --host --port 9000  -l=info  --clearScreen=false",
    "test": "NODE_ENV=test vitest",
    "test:ci": "CI=true pnpm test",
    "lint": "oxlint ./src --fix && oxfmt ./src",
    "build": "NODE_ENV=production devtools esbuild && tsc --emitDeclarationOnly -p ./tsconfig.dist.json"
  },
  "dependencies": {
    "@cutting/assert": "workspace:*",
    "@cutting/component-library": "workspace:*",
    "@cutting/util": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "react": "19.3.1",
    "react-calendly": "4.4.0",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-is": "19.3.1",
    "react-syntax-highlighter": "16.1.2"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-calendly": "4.4.0",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-is": "19.3.1"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
