{
  "name": "@cutting/oxc-config",
  "version": "1.0.1",
  "description": "Cutting Oxlint and oxfmt configuration",
  "repository": {
    "type": "git",
    "url": "https://github.com/dagda1/cuttingedge.git",
    "directory": "packages/oxc-config"
  },
  "type": "module",
  "module": "index.mjs",
  "license": "MIT",
  "files": [
    "index.mjs",
    "index.d.mts",
    "react.mjs",
    "react.d.mts",
    "oxfmt.mjs",
    "oxfmt.d.mts",
    "README.md",
    "partial.html"
  ],
  "keywords": [
    "eslint",
    "config",
    "cutting",
    "linting",
    "typescript",
    "react"
  ],
  "dependencies": {
    "eslint-plugin-simple-import-sort": "14.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0"
  },
  "exports": {
    "./eslint": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./react": {
      "types": "./react.d.mts",
      "default": "./react.mjs"
    },
    "./oxfmt": {
      "types": "./oxfmt.d.mts",
      "default": "./oxfmt.mjs"
    }
  },
  "volta": {
    "extends": "../../package.json"
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
