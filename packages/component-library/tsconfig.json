{
  "extends": "../../tsconfig-base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "~/*": ["${configDir}/src/*"],
      "~storybook/*": ["${configDir}/.storybook/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "setupTests.ts"
  ]
}
