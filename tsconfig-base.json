{
  "extends": "@cutting/tsconfig",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "sourceMap": true,
    "outDir": "${configDir}/dist/esm",
    "types": ["node", "@cutting/useful-types", "@cutting/useful-types/jsx"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "~/*": ["${configDir}/src/*"]
    }
  }
}
