{
  "name": "cuttingedge",
  "version": "4.22.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "knip": "knip",
    "all": "pnpm i && pnpm build && pnpm lint && pnpm test",
    "build": "pnpm install && pnpm turbo run build",
    "clean": "rm -rf ./packages/*/{tsconfig.*tsbuildinfo,dist}",
    "lint": "turbo run lint",
    "prepare": "husky install",
    "test": "CI=true turbo run test -- --coverage --run",
    "watch": "pnpm tsc -b ./tsconfig.packages.json --watch",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "prerelease": "pnpm clean && pnpm install --no-frozen-lockfile && pnpm run build",
    "release": "pnpm run prerelease && changeset publish && git push --follow-tags"
  },
  "dependencies": {
    "@capsizecss/core": "4.1.3",
    "@capsizecss/metrics": "4.4.0",
    "@capsizecss/vanilla-extract": "2.0.4",
    "@cutting/assert": "workspace:*",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/dynamic": "2.1.5",
    "@vanilla-extract/sprinkles": "1.7.1",
    "@visx/axis": "4.0.0",
    "@visx/curve": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@visx/text": "4.0.0",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "dayjs": "1.11.23",
    "history": "5.3.0",
    "immer": "11.2.9",
    "react": "19.3.1",
    "react-calendly": "4.4.0",
    "react-device-detect": "2.2.3",
    "react-dom": "19.3.1",
    "react-helmet": "6.1.0",
    "react-hook-form": "7.91.0",
    "react-is": "19.3.1",
    "react-router": "8.5.0",
    "use-debounce": "10.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@cutting/devtools": "workspace:*",
    "@cutting/oxc-config": "workspace:*",
    "@cutting/tsconfig": "workspace:*",
    "@cutting/useful-types": "workspace:*",
    "@mdx-js/loader": "^3.1.1",
    "@rollup/plugin-terser": "1.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "cheerio": "^1.2.0",
    "core-js": "3.51.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "follow-redirects": "1.16.2",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "node-fetch": "3.3.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "whatwg-fetch": "3.6.20"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md}": [
      "oxfmt"
    ]
  },
  "volta": {
    "node": "22.22.1",
    "npm": "11.12.0",
    "pnpm": "11.26.0"
  },
  "packageManager": "pnpm@11.26.0"
}
